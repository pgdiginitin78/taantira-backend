# Taantira Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MySQL Community Edition (Local / Self-Hosted)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taantira_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_POOL_MAX=10
DB_POOL_MIN=0

# Security & JWT (Replace with strong random 64+ char strings in any shared/live environment)
JWT_ACCESS_SECRET=change_this_local_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_local_dev_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS (comma-separated allowed frontend origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional Self-Hosted OSRM Routing Server (Leave blank to disable route geometry without paid/demo servers)
OSRM_BASE_URL=

# Binary Upload Constraints (for MySQL media storage when local disk is ephemeral)
MAX_MEDIA_SIZE_BYTES=2097152

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=25
